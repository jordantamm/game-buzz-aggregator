# ─── Reddit ────────────────────────────────────────────────────────────
# Create an app at https://www.reddit.com/prefs/apps (type: "script")
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=game-buzz-aggregator/0.1 by yourusername
REDDIT_SUBREDDITS=games,gaming,patientgamers,pcgaming,IndieGaming
REDDIT_POLL_INTERVAL_SECONDS=120
REDDIT_POLL_MAX_INTERVAL_SECONDS=600

# ─── Redpanda ──────────────────────────────────────────────────────────
REDPANDA_BROKERS=redpanda:9092
TOPIC_MENTIONS_RAW=mentions.raw
TOPIC_MENTIONS_ENRICHED=mentions.enriched
TOPIC_MENTIONS_DLQ=mentions.dlq

# ─── Postgres ──────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=gba
POSTGRES_USER=gba
POSTGRES_PASSWORD=gba_dev_password
POSTGRES_DSN=postgres://gba:gba_dev_password@postgres:5432/gba?sslmode=disable

# ─── pgAdmin ───────────────────────────────────────────────────────────
# Web GUI for browsing/querying Postgres, at http://localhost:5050.
# A connection to the `postgres` service is pre-loaded (docker/pgadmin/servers.json);
# log in with the email/password below, then enter POSTGRES_PASSWORD when it
# prompts to connect to the "Game Buzz Aggregator (local)" server.
PGADMIN_DEFAULT_EMAIL=admin@local.dev
PGADMIN_DEFAULT_PASSWORD=gba_dev_password

# ─── Redis ─────────────────────────────────────────────────────────────
REDIS_ADDR=redis:6379

# ─── MinIO ─────────────────────────────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_dev_password
MINIO_BUCKET=raw

# ─── Temporal ──────────────────────────────────────────────────────────
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=enricher

# ─── OpenTelemetry ─────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local

# ─── Anthropic ─────────────────────────────────────────────────────────
# Optional for the enricher: without a key, ambiguous mentions resolve to
# "no match" rather than being guessed at. REQUIRED for analyst-agent.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Entity resolution: alias | vector | hybrid (alias hits + vector neighbours -> LLM)
RESOLUTION_MODE=hybrid
# How many times Instructor re-asks the model when its output fails schema
# validation before the disambiguation call gives up.
LLM_MAX_RETRIES=2

# ─── Embedding service ─────────────────────────────────────────────────
# The enricher serves /embed so api-gateway and mcp-server can embed search
# queries with the SAME model that produced the stored mention vectors.
# A query embedded by a different model is not comparable, and cosine distance
# against it is noise. If this is unreachable, hybrid search degrades to
# keyword-only rather than failing.
EMBED_SERVER_PORT=8000
EMBEDDER_URL=http://enricher:8000
EMBEDDER_TIMEOUT_MS=5000

# ─── Analyst agent ─────────────────────────────────────────────────────
MCP_SERVER_URL=http://mcp-server:8081/sse
MODEL=claude-haiku-4-5-20251001
# Hard ceiling on tool calls per question. On hitting it the agent answers
# from what it gathered, with confidence lowered to reflect the shortfall.
MAX_TOOL_CALLS=6
TOOL_TIMEOUT_SECONDS=30
SERVER_PORT=8100

# ─── App config ────────────────────────────────────────────────────────
LOG_LEVEL=info
SINK_BATCH_SIZE=100
SINK_FLUSH_INTERVAL_MS=500
API_GATEWAY_PORT=8080
MCP_SERVER_HTTP_PORT=8081

# ─── Enricher tuning ───────────────────────────────────────────────────
MAX_CONCURRENT_ACTIVITIES=8
GAMES_CACHE_REFRESH_SECONDS=300
