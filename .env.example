# ─── Reddit ────────────────────────────────────────────────────────────
# Create an app at https://www.reddit.com/prefs/apps (type: "script")
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=game-buzz-aggregator/0.1 by yourusername
REDDIT_SUBREDDITS=games,gaming,patientgamers,pcgaming,IndieGaming
REDDIT_POLL_INTERVAL_SECONDS=30
REDDIT_POLL_MAX_INTERVAL_SECONDS=300

# ─── Redpanda ──────────────────────────────────────────────────────────
REDPANDA_BROKERS=redpanda:9092
TOPIC_MENTIONS_RAW=mentions.raw
TOPIC_MENTIONS_ENRICHED=mentions.enriched
TOPIC_MENTIONS_DLQ=mentions.dlq

# ─── Postgres ──────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=gba
POSTGRES_USER=gba
POSTGRES_PASSWORD=gba_dev_password
POSTGRES_DSN=postgres://gba:gba_dev_password@postgres:5432/gba?sslmode=disable

# ─── Redis ─────────────────────────────────────────────────────────────
REDIS_ADDR=redis:6379

# ─── MinIO ─────────────────────────────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_dev_password
MINIO_BUCKET=raw

# ─── Temporal ──────────────────────────────────────────────────────────
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=enricher

# ─── OpenTelemetry ─────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local

# ─── Anthropic (optional, for LLM entity-resolution fallback) ──────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ─── App config ────────────────────────────────────────────────────────
LOG_LEVEL=info
SINK_BATCH_SIZE=100
SINK_FLUSH_INTERVAL_MS=500
API_GATEWAY_PORT=8080
MCP_SERVER_HTTP_PORT=8081
